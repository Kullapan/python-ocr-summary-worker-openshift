# =============================================================================
# OCR Summary Worker — Environment Configuration
# =============================================================================

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka-bootstrap:9092
KAFKA_INPUT_TOPIC=doc-processing-requests
KAFKA_OUTPUT_TOPIC=doc-processing-results
KAFKA_GROUP_ID=ocr-summary-worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- PostgreSQL Configuration ---
DATABASE_URL=postgresql://ocruser:ocrpass@postgres:5432/ocrdb
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- AWS S3 Configuration ---
S3_BUCKET_NAME=ocr-documents
S3_ENDPOINT_URL=https://s3.vpce-xxxxxxxxx.s3.ap-southeast-1.vpce.amazonaws.com
S3_REGION_NAME=ap-southeast-1
# S3_ACCESS_KEY_ID=        # Leave unset to use IAM role / IRSA
# S3_SECRET_ACCESS_KEY=    # Leave unset to use IAM role / IRSA

# --- DOCSYS API Configuration ---
DOCSYS_BASE_URL=http://docsys-service:8080
DOCSYS_API_TOKEN=your-docsys-token

# --- DOCSYS Archive API Configuration ---
DOCSYSARC_BASE_URL=http://docsysarc-service:8080
DOCSYSARC_API_TOKEN=your-docsysarc-token

# --- Secure GPT API Configuration ---
GPT_BASE_URL=https://secure-gpt.internal.company.com
GPT_API_KEY=your-gpt-api-key
GPT_MODEL=gpt-4o
GPT_TIMEOUT_SECONDS=300
GPT_MAX_RETRIES=3

# --- OIDC / OAuth2 M2M Token Authentication Configuration ---
# Global defaults (optional fallbacks if service-specific is not set)
# OIDC_TOKEN_URL=https://keycloak.internal.company.com/auth/realms/company/protocol/openid-connect/token
# OIDC_CLIENT_ID=ocr-summary-worker-m2m
# OIDC_CLIENT_SECRET=some-client-secret
# OIDC_SCOPE=openid profile
# OIDC_AUDIENCE=

# DOCSYS API OIDC config
# DOCSYS_OIDC_TOKEN_URL=
# DOCSYS_OIDC_CLIENT_ID=
# DOCSYS_OIDC_CLIENT_SECRET=
# DOCSYS_OIDC_SCOPE=
# DOCSYS_OIDC_AUDIENCE=

# DOCSYSARC API OIDC config
# DOCSYSARC_OIDC_TOKEN_URL=
# DOCSYSARC_OIDC_CLIENT_ID=
# DOCSYSARC_OIDC_CLIENT_SECRET=
# DOCSYSARC_OIDC_SCOPE=
# DOCSYSARC_OIDC_AUDIENCE=

# Secure GPT API OIDC config
# GPT_OIDC_TOKEN_URL=
# GPT_OIDC_CLIENT_ID=
# GPT_OIDC_CLIENT_SECRET=
# GPT_OIDC_SCOPE=
# GPT_OIDC_AUDIENCE=

# --- Logging ---
LOG_LEVEL=INFO

# --- Worker Concurrency ---
WORKER_CONCURRENCY=5
