# =============================================================================
# OCR Summary Worker — Local Docker Compose Configuration
# =============================================================================

# --- Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INPUT_TOPIC=doc-processing-requests
KAFKA_OUTPUT_TOPIC=doc-processing-results
KAFKA_GROUP_ID=ocr-summary-worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- PostgreSQL Configuration ---
DATABASE_URL=postgresql://ocruser:ocrpass@postgres:5432/ocrdb
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- AWS S3 Configuration (MinIO) ---
S3_BUCKET_NAME=ocr-documents
S3_ENDPOINT_URL=http://minio:9000
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- DOCSYS API Configuration ---
DOCSYS_BASE_URL=http://mock-docsys:8080
DOCSYS_API_TOKEN=mock-docsys-static-token

# --- DOCSYS Archive API Configuration ---
DOCSYSARC_BASE_URL=http://mock-docsysarc:8080
DOCSYSARC_API_TOKEN=mock-docsysarc-static-token

# --- Secure GPT API Configuration ---
GPT_BASE_URL=http://mock-gpt:8080
GPT_API_KEY=mock-gpt-static-token
GPT_MODEL=gpt-4o
GPT_TIMEOUT_SECONDS=300
GPT_MAX_RETRIES=3

# --- OIDC / OAuth2 M2M Token Authentication Configuration ---
# Global defaults
OIDC_TOKEN_URL=http://mock-oidc:8080/token
OIDC_CLIENT_ID=ocr-summary-worker-m2m
OIDC_CLIENT_SECRET=some-client-secret
OIDC_SCOPE=openid profile
OIDC_AUDIENCE=

# Service-specific OIDC configuration (enables OIDC flows in oidc_service)
DOCSYS_OIDC_TOKEN_URL=http://mock-oidc:8080/token
DOCSYS_OIDC_CLIENT_ID=docsys-client
DOCSYS_OIDC_CLIENT_SECRET=docsys-secret
DOCSYS_OIDC_SCOPE=docsys-scope

DOCSYSARC_OIDC_TOKEN_URL=http://mock-oidc:8080/token
DOCSYSARC_OIDC_CLIENT_ID=docsysarc-client
DOCSYSARC_OIDC_CLIENT_SECRET=docsysarc-secret
DOCSYSARC_OIDC_SCOPE=docsysarc-scope

GPT_OIDC_TOKEN_URL=http://mock-oidc:8080/token
GPT_OIDC_CLIENT_ID=gpt-client
GPT_OIDC_CLIENT_SECRET=gpt-secret
GPT_OIDC_SCOPE=gpt-scope

# --- Logging ---
LOG_LEVEL=INFO

# --- Worker Concurrency ---
WORKER_CONCURRENCY=5
