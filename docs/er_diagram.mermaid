erDiagram
    job_states {
        varchar id PK "PRIMARY KEY, client-provided correlation ID"
        varchar docid "Document ID in DOCSYS (Indexed)"
        varchar fileid "File ID within the document"
        varchar state "Current pipeline step/state (Indexed)"
        varchar filename "Original document filename (Nullable)"
        text error_message "Error description if state failed (Nullable)"
        varchar worker_id "Hostname of claiming pod (Nullable)"
        timestamptz locked_at "Timestamp of claim lock (Nullable)"
        timestamptz leased_until "Lease expiration timestamp (Nullable)"
        timestamptz created_at "Timestamp of job creation"
        timestamptz updated_at "Timestamp of last status modification"
    }

    openid_tokens {
        varchar service_name PK "PRIMARY KEY (docsys, docsysarc, or gpt)"
        text access_token "Cached M2M token value"
        timestamptz expires_at "Token expiration timestamp"
        timestamptz updated_at "Timestamp of last token refresh"
    }
